{
  "name": "qa-auto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:content": "node scripts/check-content.ts",
    "check:code": "f=node_modules/.cache/check-code-$$.mjs; rolldown scripts/check-code.ts --platform node --format esm -o $f --log-level silent >/dev/null && CHECK_CODE_SELF=$f node $f",
    "audio": "node scripts/audio.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run check:content && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.5",
    "@lezer/python": "^1.1.19",
    "canvas-confetti": "^1.9.4",
    "codemirror": "^6.0.2",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
